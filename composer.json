{
    "name": "loick/devoir-touche-pas-klaxon-php",
    "description": "CEF Homework - Enterprise web application made with PHP to manage car sharing",
    "type": "project",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "App\\": "App/",
            "Core\\": "Core/",
            "Router\\": "Router/"
        },
        "files": [
            "bootstrap.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "dev": [
            "php -S localhost:8080 -t public public/index.php",
            "Composer\\Config::disableProcessTimeout"
        ],
        "lint": "find App Core Router public templates tests -name '*.php' -print0 | xargs -0 -n1 php -l",
        "phpstan": "phpstan analyse",
        "test": "./vendor/bin/phpunit"
    },
    "authors": [
        {
            "name": "loickcherimont",
            "email": "loickcherimont@gmail.com"
        }
    ],
    "require-dev": {
        "phpunit/phpunit": "^13.3",
        "phpstan/phpstan": "^2.2"
    },
    "require": {
        "izniburak/router": "^3.1"
    }
}
